# Required. Get one from https://developer.hypixel.net
HYPIXEL_API_KEY=your-key-here

# Optional overrides (defaults shown)
HYPIXEL_BASE_URL=https://api.hypixel.net
TICK_POLL_INTERVAL_MS=750
REQUEST_TIMEOUT_MS=5000
STORAGE_DB_PATH=auctions.sqlite3
WEBSOCKET_BIND_ADDR=127.0.0.1:9001

# COFL (sky.coflnet.com) historical price backfill -- see the cofl
# crate. Set COFL_BACKFILL_ENABLED to false in environments without
# network access to sky.coflnet.com.
COFL_BACKFILL_ENABLED=true
COFL_BASE_URL=https://sky.coflnet.com/api
# Defaults to a ~100-item curated list (endgame weapons/accessories +
# high-volume enchanted materials) if unset -- see
# DEFAULT_COFL_BACKFILL_ITEM_TAGS in crates/common/src/lib.rs. Override
# here to use a different/shorter list.
# COFL_BACKFILL_ITEM_TAGS=HYPERION,NECRON_HANDLE,ASTRAEA,SCYLLA,VALKYRIE,ASPECT_OF_THE_END
COFL_BACKFILL_PAGES_PER_TAG=3
# How often (minutes) to re-run the backfill after the initial startup
# crawl, so price coverage keeps growing/refreshing during operation.
# 0 disables the repeat (startup-only).
COFL_BACKFILL_INTERVAL_MINUTES=60
